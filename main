function hl(text) {
  return text
    .replace(/\[\[p:(.*?)\]\]/g, '<span class="hl-p">$1</span>')
    .replace(/\[\[t:(.*?)\]\]/g, '<span class="hl-t">$1</span>')
    .replace(/\[\[b:(.*?)\]\]/g, '<span class="hl-b">$1</span>')
    .replace(/\[\[o:(.*?)\]\]/g, '<span class="hl-o">$1</span>')
    .replace(/\[\[g:(.*?)\]\]/g, '<span class="hl-g">$1</span>');
}

function buildNav() {
  const nav = document.getElementById('sb-nav');
  nav.innerHTML = NAV.map(g =>
    `<div class="nav-group">${g.label}</div>` +
    g.items.map(i => {
      const ch = CHAPTERS[i];
      return `<div class="nav-item" id="nav-${i}" onclick="openChapter(${i})">
        <span class="nav-badge">${i+1}</span>${ch.title}
      </div>`;
    }).join('')
  ).join('');
}

function buildWelcome() {
  document.getElementById('welcome-grid').innerHTML = CHAPTERS.map((ch, i) =>
    `<div class="welcome-chip" onclick="openChapter(${i})">${ch.title}</div>`
  ).join('');
}

function openChapter(idx) {
  const ch = CHAPTERS[idx];
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  const navEl = document.getElementById('nav-' + idx);
  if (navEl) { navEl.classList.add('active'); navEl.scrollIntoView({ block: 'nearest' }); }
  document.getElementById('welcome-screen').style.display = 'none';
  const view = document.getElementById('chapter-view');
  view.style.display = 'block';

  const partiesHTML = ch.parties.map(p =>
    `<div class="partie-block">
      <div class="partie-title">
        <span class="partie-num">Partie ${p.num}</span>${p.title}
      </div>
      <ul class="partie-points">
        ${p.points.map(pt => `<li class="partie-point">${pt}</li>`).join('')}
      </ul>
    </div>`
  ).join('');

  const formulesHTML = ch.formules.map(f =>
    `<div class="formule-item">
      <div>
        <div class="formule-text">${f.f}</div>
        <div class="formule-note">${f.n}</div>
      </div>
    </div>`
  ).join('');

  const retenirHTML = ch.retenir.map(r =>
    `<div class="retenir-box">
      <div class="retenir-formula">${r.f}</div>
      <div class="retenir-note">${r.n}</div>
    </div>`
  ).join('');

  view.innerHTML = `
    <div class="top-bar">
      <div>
        <div class="chapter-meta">Chapitre ${idx+1} · ${ch.group}</div>
        <div class="chapter-title">${ch.title}</div>
        <div class="chapter-subtitle">${ch.sub}</div>
      </div>
      <button class="print-btn" onclick="window.print()">🖨 Imprimer</button>
    </div>

    <div class="idee-box">
      <div class="idee-label">🎯 Idée clé</div>
      <div class="idee-text">${hl(ch.idee)}</div>
    </div>

    <div class="sec-header teal">📌 Cours</div>
    ${partiesHTML}

    <div class="sec-header teal">🔑 Formules clés</div>
    ${formulesHTML}

    <div class="sec-header gold">✏ À retenir absolument</div>
    ${retenirHTML}
  `;

  document.querySelector('.main').scrollTop = 0;
}

buildNav();
buildWelcome();
</script>
</body>
</html>
